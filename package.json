{
  "name": "dr-meow",
  "productName": "Dr. Meow",
  "version": "1.1.0",
  "description": "A quiet desktop cat and ChatGPT companion for Windows and macOS",
  "author": "Dr. Meow contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:desktop": "electron . --desktop-smoke",
    "dist:win": "tsc --noEmit && node scripts/build.mjs && electron-builder --win nsis --x64",
    "pack:win": "tsc --noEmit && node scripts/build.mjs && electron-builder --win --dir --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack:mac": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.0",
    "vite": "~8.3.0"
  }
}
